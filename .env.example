NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Required for login by selected profile and admin user management.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Cloudinary credentials used by /api/evidence.
# CLOUDINARY_FOLDER is optional; it groups uploaded evidence assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tanqueo/evidencias
