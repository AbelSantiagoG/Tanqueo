NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Required for login by selected profile and admin user management.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Cloudinary credentials used by /api/evidence.
# CLOUDINARY_FOLDER is optional; it groups uploaded evidence assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tanqueo/evidencias

# Optional automatic notification when an order is closed or executed.
# The recipient falls back to the company phone/email saved in Configuracion.
ADMIN_NOTIFICATION_PHONE=+573001234567
ADMIN_NOTIFICATION_EMAIL=admin@empresa.com

# Preferred channel: Twilio WhatsApp. SMS uses the same Twilio account as fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Leave blank in the WhatsApp Sandbox to send a free-form Body.
# Set only when using an approved WhatsApp content template.
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_SMS_FROM=

# Email fallback through Resend.
RESEND_API_KEY=
RESEND_FROM=ASUCAP <notificaciones@empresa.com>
